table "PUBLIC"."PRODUCTS" {
  columns = (
    column "PRODUCT_ID" {
      type = NUMBER(38,0)
    }
    column "PRODUCT_NAME" {
      type = VARCHAR(16777216)
    }
    column "CATEGORY" {
      type = VARCHAR(16777216)
    }
    column "UNIT_PRICE" {
      type = NUMBER(10,2)
    }
    column "IS_ACTIVE" {
      type = BOOLEAN
    }
  )
}


table "PUBLIC"."ORDERS" {
  columns = (
    column "ORDER_ID" {
      type = NUMBER(38,0)
    }
    column "CUSTOMER_ID" {
      type = NUMBER(38,0)
    }
    column "ORDER_DATE" {
      type = DATE
    }
    column "STATUS" {
      type = VARCHAR(16777216)
    }
    column "ORDER_TOTAL" {
      type = NUMBER(10,2)
    }
  )
}


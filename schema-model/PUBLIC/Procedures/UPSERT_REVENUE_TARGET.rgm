procedure "PUBLIC"."UPSERT_REVENUE_TARGET(DATE, VARCHAR, NUMBER)" {
  returnType = VARCHAR(134217728)
  body = """

BEGIN
  MERGE INTO STEPHANIE_DEV.PUBLIC.MONTHLY_REVENUE_TARGETS t
  USING (
    SELECT :P_TARGET_MONTH AS TARGET_MONTH,
           :P_SEGMENT AS SEGMENT,
           :P_TARGET_REVENUE AS TARGET_REVENUE
  ) s
  ON t.TARGET_MONTH = s.TARGET_MONTH
 AND t.SEGMENT = s.SEGMENT
  WHEN MATCHED THEN UPDATE SET TARGET_REVENUE = s.TARGET_REVENUE
  WHEN NOT MATCHED THEN INSERT (TARGET_MONTH, SEGMENT, TARGET_REVENUE)
  VALUES (s.TARGET_MONTH, s.SEGMENT, s.TARGET_REVENUE);

  RETURN 'Revenue target upserted';
END;
"""
  parameters = <
    {
      name = P_TARGET_MONTH
      type = DATE
    }

    {
      name = P_SEGMENT
      type = VARCHAR
    }

    {
      name = P_TARGET_REVENUE
      type = NUMBER(10,2)
    }

  >
}


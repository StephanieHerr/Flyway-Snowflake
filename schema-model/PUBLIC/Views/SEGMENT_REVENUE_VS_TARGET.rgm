view "PUBLIC"."SEGMENT_REVENUE_VS_TARGET" {
  body = """-
SELECT
  DATE_TRUNC('MONTH', o.ORDER_DATE) AS TARGET_MONTH,
  c.SEGMENT,
  SUM(o.ORDER_TOTAL) AS ACTUAL_REVENUE,
  t.TARGET_REVENUE,
  SUM(o.ORDER_TOTAL) - t.TARGET_REVENUE AS REVENUE_VARIANCE
FROM STEPHANIE_DEV.PUBLIC.ORDERS o
JOIN STEPHANIE_DEV.PUBLIC.CUSTOMERS c
  ON o.CUSTOMER_ID = c.CUSTOMER_ID
LEFT JOIN STEPHANIE_DEV.PUBLIC.MONTHLY_REVENUE_TARGETS t
  ON DATE_TRUNC('MONTH', o.ORDER_DATE) = t.TARGET_MONTH
 AND c.SEGMENT = t.SEGMENT
GROUP BY 1, 2, 4
"""
}


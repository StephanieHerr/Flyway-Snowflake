view "PUBLIC"."ORDER_ITEM_DETAILS" {
  body = """-
SELECT
  oi.ORDER_ITEM_ID,
  oi.ORDER_ID,
  o.ORDER_DATE,
  o.STATUS,
  c.CUSTOMER_ID,
  c.CUSTOMER_NAME,
  c.SEGMENT,
  p.PRODUCT_ID,
  p.PRODUCT_NAME,
  p.CATEGORY,
  oi.QUANTITY,
  oi.LINE_TOTAL
FROM STEPHANIE_DEV.PUBLIC.ORDER_ITEMS oi
JOIN STEPHANIE_DEV.PUBLIC.ORDERS o
  ON oi.ORDER_ID = o.ORDER_ID
JOIN STEPHANIE_DEV.PUBLIC.CUSTOMERS c
  ON o.CUSTOMER_ID = c.CUSTOMER_ID
JOIN STEPHANIE_DEV.PUBLIC.PRODUCTS p
  ON oi.PRODUCT_ID = p.PRODUCT_ID
"""
}


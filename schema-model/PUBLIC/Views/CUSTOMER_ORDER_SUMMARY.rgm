view "PUBLIC"."CUSTOMER_ORDER_SUMMARY" {
  body = """-
SELECT
  c.CUSTOMER_ID,
  c.CUSTOMER_NAME,
  c.SEGMENT,
  COUNT(o.ORDER_ID) AS ORDER_COUNT,
  COALESCE(SUM(o.ORDER_TOTAL), 0) AS TOTAL_SPENT,
  MAX(o.ORDER_DATE) AS LAST_ORDER_DATE
FROM STEPHANIE_DEV.PUBLIC.CUSTOMERS c
LEFT JOIN STEPHANIE_DEV.PUBLIC.ORDERS o
  ON c.CUSTOMER_ID = o.CUSTOMER_ID
GROUP BY 1,2,3;
"""
}

